{
  "name": "dot-collector-game",
  "version": "1.0.0",
  "homepage": "https://YOUR_USERNAME.github.io/dot-collector-game",
  "description": "A fast-paced dot collection game built with React and Canvas",
  "author": "Your Name",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "react-scripts": "5.0.1",
    "typescript": "^5.0.0",
    "web-vitals": "^3.0.0",
    "gh-pages": "^5.0.0",
    "webpack-bundle-analyzer": "^4.9.0",
    "serve": "^14.0.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "dev": "react-scripts start",
    "build": "react-scripts build",
    "build:analyze": "npm run build && webpack-bundle-analyzer build/static/js/main.*.js",
    "build:production": "GENERATE_SOURCEMAP=true react-scripts build",
    "serve": "serve -s build -l 5000",
    "test": "react-scripts test",
    "test:coverage": "react-scripts test --coverage --watchAll=false",
    "eject": "react-scripts eject",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,md}\"",
    "clean": "rm -rf build dist coverage node_modules/.cache",
    "clean:deps": "rm -rf node_modules package-lock.json && npm install",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "deploy:vercel": "vercel --prod",
    "deploy:netlify": "netlify deploy --prod --dir=build",
    "deploy:check": "npm run type-check && npm run lint && npm run test:coverage && npm run build",
    "preversion": "npm run deploy:check",
    "postversion": "git push --tags",
    "prepare": "npm run build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/index.ts",
      "!src/**/*.types.ts",
      "!src/**/*.d.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 75,
        "lines": 75,
        "statements": 75
      }
    }
  }
}
